      { "name" : "mixed case, as a keyboard that capitalises each group leaves it", "artifact" : "Gua-recovery-1 Tvq3 Dhpp 7vng Boue Jl2j F3bm Yrce Trlj Pmzg Sglq Howa Ghfo P5qa", "key" : "rfc8032-test1" },
